# Local development environment.
# NEVER commit a real .env - it holds secrets. This file is a template only.

APP_ENV=local
APP_DEBUG=1
APP_URL=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nico
DB_USER=nico
DB_PASSWORD=devpass

SESSION_NAME=nico_session
SESSION_LIFETIME=7200

STORAGE_PATH=storage/files
VECTOR_PATH=storage/vectors
PDF_MAX_BYTES=20971520
PDF_TEXT_MAX_BYTES=2097152

# Optional local-only AI provider. Never commit a real key.
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CHAT_MODEL=qwen141:latest

# Worker / queue (M0). The worker signs every request with WORKER_SECRET.
WORKER_SECRET=dev-worker-secret-change-me
JOB_LEASE_SECONDS=300
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=30
WORKER_CLOCK_SKEW=300
REQUIRE_HTTPS=0
